DJANGO_SETTINGS_MODULE=config.settings.portfolio
DJANGO_SECRET_KEY=replace-with-a-random-local-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional integrations. Leave empty for the local portfolio build.
EMAIL_HOST=localhost
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TECHNO_SERVICE=service@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_LINK=https://t.me/example_helpdesk_bot
